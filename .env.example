# Contact form (Resend) — the sender domain must be verified in Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Google Analytics 4 (optional — GA loads only when set)
NEXT_PUBLIC_GA_ID=

# Public URL of THIS deployment (canonical links, sitemap, share images)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# The real production URL. The site is indexable only when NEXT_PUBLIC_SITE_URL
# equals this; previews/staging get noindex + robots "Disallow: /".
PRODUCTION_SITE_URL=https://www.example.com

# Google Search Console meta-tag verification (optional if verified by DNS)
GOOGLE_SITE_VERIFICATION=
